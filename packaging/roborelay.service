[Unit]
Description=RoboRelay
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=roborelay
Group=roborelay
StateDirectory=roborelay
StateDirectoryMode=0700
WorkingDirectory=/var/lib/roborelay
Environment=HOME=/var/lib/roborelay
ExecStart=/usr/bin/roborelay
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
