#!/bin/sh
set -e
case "$1" in
  remove|purge)
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload
    fi
    ;;
esac
if [ "$1" = purge ]; then
  deb-systemd-helper purge roborelay.service >/dev/null
fi
# Keep queued readings and the service account so removal cannot lose telemetry.
